# Copy this file to ".env" and paste your free keys. Never share or upload .env.
# Any key you leave empty is skipped. Free tiers limit each key per day, so you may add
# up to 4 Groq keys (from separate accounts); the run rotates between them (v0.2.1).
# Models up to ~14B need no key: they run on your computer with Ollama (https://ollama.com).

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=

# Google AI Studio (free tier; Gemma open models): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Mistral (free "Experiment" plan; open Mistral models): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Optional extra routes (not used by the default model list)
OPENROUTER_API_KEY=
HF_TOKEN=
CEREBRAS_API_KEY=
