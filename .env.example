# Copy this file to ".env" and paste your free keys. Never share or upload .env.
# Any key you leave empty is skipped; models then use their backup route (often Ollama).

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (free models): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Hugging Face (free token, "read" is enough): https://huggingface.co/settings/tokens
HF_TOKEN=
